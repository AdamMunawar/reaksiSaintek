# ==============================================================================
# LPM REAKSI PORTAL - ENVIRONMENT VARIABLES CONFIGURATION (HTTPS & POSTGRESQL)
# ==============================================================================

# Database Connection URL (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Contoh Supabase:
# DATABASE_URL="postgresql://postgres.xxx:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"
# Contoh Local / VPS PostgreSQL:
# DATABASE_URL="postgresql://reaksi_user:SuperSecretPassword123@localhost:5432/lpm_reaksi_db"
DATABASE_URL=""

# PostgreSQL SSL Mode ('true' untuk mengaktifkan SSL connection saat production/hosting)
DATABASE_SSL="false"

# Next.js Site URL (Wajib menggunakan protokol HTTPS saat live)
NEXT_PUBLIC_SITE_URL="https://reaksisaintek.com"

# Server-Side JWT Secret Key (Kunci enkripsi session cookie HttpOnly)
JWT_SECRET="lpm-reaksi-super-secret-jwt-key-2026-production"

# Upload Max Size (Bytes - Default 5MB)
NEXT_PUBLIC_MAX_UPLOAD_SIZE=5242880
